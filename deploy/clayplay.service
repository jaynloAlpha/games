[Unit]
Description=Clay Play - kids mini game arcade
Documentation=https://github.com/jaynloAlpha/games
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clayplay
Group=clayplay
WorkingDirectory=/opt/clayplay
ExecStart=/opt/clayplay/clayplay
Restart=on-failure
RestartSec=3

Environment=CLAY_BIND=127.0.0.1:8080
Environment=CLAY_GAMES_DIR=/opt/clayplay/games
Environment=CLAY_SITE_FILE=/opt/clayplay/site.json
Environment=CLAY_WATCH=0
Environment=RUST_LOG=clayplay=info,tower_http=warn

# 服务只读，不需要写权限
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/clayplay

[Install]
WantedBy=multi-user.target
